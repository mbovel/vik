; Hand-written for VIK (this repository's license): the third solve constrains a
; new application, `(g 1)`, on top of a re-asserted one.
(declare-const g (-> Int Int))
(assert (or (= g (lambda ((x Int)) (+ x 1))) (= g (lambda ((x Int)) (+ x 5)))))
(push)
(assert (= (g 0) 5))
(set-info :status sat)
(check-sat)
(pop)
(push)
(assert (= (g 0) 3))
(set-info :status unsat)
(check-sat)
(pop)
(push)
(assert (= (g 0) 5))
(assert (= (g 1) 2))
(set-info :status unsat)
(check-sat)
(pop)
