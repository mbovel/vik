; From yices2: mcsat/uf/z3.630166.smt2 (BSD-3-Clause, LICENSES/yices2.txt)
; logic: QF_UFLRA, the smallest the script fits, for QF_UFNRA (prune logic)
(set-logic QF_UFLRA)
(set-info :source |Benchmarks from the paper: "Extending Sledgehammer with SMT Solvers" by Jasmin Blanchette, Sascha Bohme, and Lawrence C. Paulson, CADE 2011.  Translated to SMT2 by Andrew Reynolds and Morgan Deters.|)
(set-info :smt-lib-version 2.0)
(set-info :category "industrial")
(set-info :status sat)
(declare-sort S1 0)
(declare-fun f1 () S1)
(declare-fun f2 () S1)
(declare-fun f3 (Real) Real)
(declare-fun f4 () Real)
(declare-fun f5 () Real)
(assert (not (= f1 f2)))
(assert (not (not (= (f3 f4) 0.0))))
(assert (< f5 f4))
(assert (< f4 (* 2.0 f5)))
(assert (not (= (f3 (- f4 f5)) 0.0)))
(set-info :status sat)
(check-sat)
(exit)
