; From yices2: mcsat/bool/bool_08.smt2 (BSD-3-Clause, LICENSES/yices2.txt)
(set-logic QF_UF)
(set-info :smt-lib-version 2.0)
(declare-fun x () Bool)
(declare-fun y () Bool)
(assert (or x y))
(assert (or x (not y)))
(assert (or (not x) y))
(assert (or (not x) (not y)))
(set-info :status unsat)
(check-sat)
(exit)
