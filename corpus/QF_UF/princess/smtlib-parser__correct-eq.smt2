; logic: QF_UF, the smallest the script fits, for AUFLIA (prune logic)
(set-logic QF_UF)
(declare-fun p1 () Bool)
(declare-fun p2 () Bool)
(declare-fun p3 () Bool)

(assert (not (= (= p1 p2 p3)
                (and (= p1 p2) (= p2 p3)))))
(set-info :status unsat)
(check-sat)
(exit)
