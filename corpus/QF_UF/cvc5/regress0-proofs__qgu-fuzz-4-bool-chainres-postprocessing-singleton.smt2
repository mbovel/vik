; EXPECT: unsat
; logic: QF_UF, the smallest the script fits, for ALL (prune logic)
(set-logic QF_UF)
(declare-fun b () Bool)
(declare-fun c () Bool)
(declare-fun d () Bool)
(assert (and (or d (ite c false true)) (not (= d (or b c))) (= d (ite c d (not d)))))
(set-info :status unsat)
(check-sat)
