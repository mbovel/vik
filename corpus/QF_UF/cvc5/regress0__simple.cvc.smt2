; From cvc5: regress0/simple.cvc.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: unsat
; logic: QF_UF, the smallest the script fits, for ALL (prune logic)
(set-logic QF_UF)
(set-option :incremental false)
(declare-fun x0 () Bool)
(declare-fun x1 () Bool)
(declare-fun x2 () Bool)
(declare-fun x3 () Bool)
(assert (or x1 (not x0)))
(assert (or x0 (not x3)))
(assert (or x3 x2))
(assert (and x1 (not x1)))
(set-info :status unsat)
(check-sat-assuming ( x2 ))
