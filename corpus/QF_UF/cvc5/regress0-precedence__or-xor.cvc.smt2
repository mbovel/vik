; From cvc5: regress0/precedence/or-xor.cvc.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: unsat
; logic: QF_UF, the smallest the script fits, for ALL (prune logic)
(set-logic QF_UF)
(set-option :incremental false)
(declare-fun A () Bool)
(declare-fun B () Bool)
(declare-fun C () Bool)
(set-info :status unsat)
(check-sat-assuming ( (not (let ((_let_1 (or (xor A B) C))) (let ((_let_2 (xor (or A B) C))) (and (= _let_2 _let_2) (= _let_1 _let_1))))) ))
