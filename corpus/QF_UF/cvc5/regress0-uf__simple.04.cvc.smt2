; From cvc5: regress0/uf/simple.04.cvc.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: sat
; logic: QF_UF, the smallest the script fits, for ALL (prune logic)
(set-logic QF_UF)
(set-option :incremental false)
(declare-sort A 0)
(declare-sort B 0)
(declare-fun x () A)
(declare-fun y () A)
(declare-fun a () A)
(declare-fun b () A)
(declare-fun f (A) B)
(assert (and (or (= x a) (= x b)) (or (= y b) (= y a))))
(set-info :status sat)
(check-sat-assuming ( (= (f x) (f y)) ))
