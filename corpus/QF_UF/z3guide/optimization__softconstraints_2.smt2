; logic: QF_UF, the smallest the script fits, which set none (prune logic)
(set-logic QF_UF)
(declare-const a1 Bool)
(declare-const a2 Bool)
(declare-const a3 Bool)
(assert-soft a1 :weight 0.1)
(assert-soft a2 :weight 1.0)
