; EXPECT: sat
; EXPECT: ((define-fun a () Bool false) (define-fun b () Bool false) (define-fun c () Bool false))
; logic: QF_UF, the smallest the script fits, which set none (prune logic)
(set-logic QF_UF)
(declare-const a Bool)
(declare-const b Bool)
(declare-const c Bool)
(assert-soft a :weight 1 :id A)
(assert-soft b :weight 2 :id B)
(assert-soft c :weight 3 :id A)
(assert (= a c))
(assert (not (and a b)))
(set-info :status sat)
(check-sat)
(get-model)
(get-objectives)
