(declare-sort A)
(declare-fun f (A) A)
(declare-const x A)
(assert (= (f (f x)) x))
(assert (= (f (f (f x))) x))
(set-info :status sat)
(check-sat)
(get-model)
  
(assert (not (= (f x) x)))
(set-info :status unsat)
(check-sat)
