; Hand-written for VIK (this repository's license): a conflict among the top-level assertions alone,
; found at decision level 0, must hold for every later check — a plain re-check, a check under an
; assumption, a check under a push, and a check with one more assertion (issue 37). Before the fix the
; third answer of each group was sat, with a model against the assertions.
(set-logic QF_UF)
(set-option :global-declarations true)
(declare-const u Bool)
(declare-const f Bool)
(declare-const p Bool)
(declare-const q Bool)
(declare-const r Bool)
(assert (or (not u) (not f)))
(assert f)
(assert u)
(set-info :status unsat)
(check-sat)
(set-info :status unsat)
(check-sat)
(set-info :status unsat)
(check-sat-assuming (q))
(push 1)
(assert q)
(set-info :status unsat)
(check-sat)
(pop 1)
(assert (or p q))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (and r p))
(assert (=> (=> r p) (and q false)))
(set-info :status unsat)
(check-sat)
(set-info :status unsat)
(check-sat-assuming (q))
(assert (or p q))
(set-info :status unsat)
(check-sat)
