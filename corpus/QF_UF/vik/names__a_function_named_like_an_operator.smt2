; Hand-written for VIK (this repository's license): in a logic without arithmetic a script may declare
; or define a function named `+`, `-`, `*`, `to_real` or `to_int`, and it is its own uninterpreted
; symbol, not the operator (issue 41). VIK read the applications as the theory's operators and decided
; commutativity for a symbol that has none, answering unsat on every check below.
(set-logic QF_UF)
(declare-sort U 0)
(declare-fun + (U U) U)
(declare-fun - (U U) U)
(declare-fun to_real (U) U)
(declare-fun to_int (U) U)
(declare-fun g (U U) U)
(define-fun * ((x U) (y U)) U (g x y))
(declare-const a U)
(declare-const b U)
(push 1)
(assert (distinct (+ a b) (+ b a)))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct a b))
(assert (= (- a b) (- b a)))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (to_real a) a))
(assert (distinct (to_int (to_real a)) a))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (* a b) (* b a)))
(set-info :status sat)
(check-sat)
(pop 1)
(assert (= (+ a b) (+ b a)))
(assert (distinct (+ a b) (+ b a)))
(set-info :status unsat)
(check-sat)
