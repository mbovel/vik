; From z3test: 3732.smt2 (MIT, LICENSES/z3test.txt)
; logic: QF_UF, the smallest the script fits, which set none (prune logic)
(set-logic QF_UF)
(declare-sort a)
(declare-fun b (a a) a)
(declare-fun c () a)
(declare-fun d () a)
(declare-fun e () a)
(declare-fun f () a)
(assert (= e d (b e c) f))
(assert (distinct f (b d c)))
(set-info :status unsat)
(check-sat)
(set-info :status unsat)
(check-sat-using (then qffd smt))
