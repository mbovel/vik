; logic: QF_UF, the smallest the script fits, which set none (prune logic)
(set-logic QF_UF)
(set-option :bv-solver "prop")
(declare-const x Bool)
(declare-const x1 Bool)
(declare-const x5 Bool)
(set-info :status sat)
(check-sat-assuming ((ite x x1 true)))
(set-info :status sat)
(check-sat-assuming ((not (ite (and x x5) false (ite x x1 true)))))
(set-info :status sat)
(check-sat-assuming ((ite x x1 true)))
