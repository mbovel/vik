; logic: QF_UF, the smallest the script fits, for QF_UFBV (prune logic)
(set-logic QF_UF)
(set-info :status unsat)
(declare-fun f (Bool) Bool)
(declare-const a Bool)
(declare-const b Bool)
(assert (distinct a b))
(assert (distinct (f a) (f b)))
(assert (f a))
(assert (f (f (f b))))
(check-sat)
