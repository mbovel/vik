(set-logic QF_UF)
(declare-fun x () Bool)
(assert x)
(set-info :status sat)
(check-sat)
(push 1)
(assert (not x))
(set-info :status unsat)
(check-sat)
(pop 1)
(set-info :status sat)
(check-sat)
(declare-fun y () Bool)
(assert (or (not x) y))
(push 1)
(set-info :status sat)
(check-sat)
