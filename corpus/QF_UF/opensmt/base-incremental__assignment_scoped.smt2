(set-option :produce-assignments true)
(set-logic QF_UF)
(declare-fun a () Bool)
(declare-fun b () Bool)
(assert (or a b))
(push 1)
(assert (! a :named n0))
(set-info :status sat)
(check-sat)
(pop 1)
(assert (! (xor a b) :named n1))
(assert (! a :named n2))
(set-info :status sat)
(check-sat)
(get-assignment)
