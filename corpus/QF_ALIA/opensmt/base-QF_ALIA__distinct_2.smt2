(set-logic QF_ALIA)
(set-info :status unsat)
(declare-fun b () (Array Int Int))
(declare-fun j () Int)
(declare-fun a () (Array Int Int))
(declare-fun i () Int)
(assert (= (store b i j) (store a (select a i) i)))
(assert (distinct j (select a i)))
(set-info :status unsat)
(check-sat)
