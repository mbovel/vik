; Hand-written for VIK (this repository's license): arrays of arrays are
; extensional at every level — writing back what was read changes nothing,
; and a store on an inner array differs from the outer array it came from
; exactly where the value differs.
(set-logic QF_AX)
(declare-sort I 0)
(declare-sort E 0)
(declare-const a (Array I (Array I E)))
(declare-const b (Array I (Array I E)))
(declare-const i I)
(declare-const j I)
(declare-const v E)
(declare-const w E)
(push 1)
(assert (= b (store a i (store (select a i) j v))))
(assert (not (= (select (select b i) j) v)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (= b (store a i (store (select a i) j (select (select a i) j)))))
(assert (not (= a b)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (= b (store a i (store (select a i) j v))))
(assert (not (= a b)))
(assert (distinct v w))
(set-info :status sat)
(check-sat)
(assert (= (select (select a i) j) v))
(set-info :status unsat)
(check-sat)
(pop 1)
