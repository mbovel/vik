; logic: QF_AX, the smallest the script fits, for QF_ANIA (prune logic)
(set-logic QF_AX)
(declare-fun v () Bool)
(declare-fun v1 () Bool)
(declare-fun a () (Array Bool Bool))
(assert (select a false))
(assert (or v (select (store a true false) v1)))
(set-info :status sat)
(check-sat)
