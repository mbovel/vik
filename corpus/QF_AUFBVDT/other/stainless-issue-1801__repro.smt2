; origin: Stainless issue 1801 (https://github.com/epfl-lara/stainless/issues/1801), the standalone reproduction of a `get-model` blow-up of z3 5.x on arrays of datatypes that contain arrays, reduced from a verification condition of ZipLex (the memoisation cache of `ZipperDerivationStepsMemoized`, https://github.com/epfl-lara/bolts/pull/165)
; original path: repro.smt2 in the issue, as written there but for this header, the logic, `:produce-models` and the status, and `check-sat-assuming` for z3's shorthand, which hands the assumption to `check-sat` itself; not one of Stainless's own benchmarks
; license: none stated by the source; status from z3 4.14, which answers the file in 20 ms; z3 5.3.1 answers `sat` as fast, then does not finish the `get-model` in 40 s and 16 GB
(set-option :produce-models true)
(set-option :produce-unsat-assumptions true)
(set-logic QF_AUFBVDT)
(define-sort InoxSet (T) (Array T Bool))
(declare-datatypes ((Regex 0)) (((ElementSet (cs (InoxSet (_ BitVec 16)))) (Concat (r1 Regex) (r2 Regex)) (ElementMatch (c (_ BitVec 16))) (Union (u1 Regex) (u2 Regex)) (EmptyExpr) (Star (reg Regex)) (EmptyLang))))
(declare-datatypes ((RList 0)) (((RCons (rh Regex) (rt RList)) (RNil))))
(declare-datatypes ((Context 0)) (((Context (exprs RList)))))
(declare-datatypes ((Key 0)) (((Key (k1 Context) (k2 (_ BitVec 16))))))
(declare-datatypes ((Entry 0)) (((Entry (key Key) (value (InoxSet Context))))))
(declare-datatypes ((EList 0)) (((ECons (eh Entry) (et EList)) (ENil))))
(declare-fun p () Bool)
(declare-fun nonEmpty () Bool)
(declare-fun arr () (Array (_ BitVec 32) EList))
(declare-fun rest () (Array (_ BitVec 32) EList))
(declare-fun k () (_ BitVec 32))
(declare-fun v () EList)
(assert (=> nonEmpty (= arr (store rest k v))))
(declare-fun nonEmpty2 () Bool)
(declare-fun arr2 () (Array (_ BitVec 32) EList))
(declare-fun rest2 () (Array (_ BitVec 32) EList))
(declare-fun kk2 () (_ BitVec 32))
(declare-fun v2 () EList)
(assert (=> nonEmpty2 (= arr2 (store rest2 kk2 v2))))
(set-info :status sat)
(check-sat-assuming (p))
(get-model)
