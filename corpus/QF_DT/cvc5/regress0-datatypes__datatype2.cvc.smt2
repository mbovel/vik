; From cvc5: regress0/datatypes/datatype2.cvc.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: unsat
; logic: QF_DT, the smallest the script fits, for ALL (prune logic)
(set-logic QF_DT)
(set-option :incremental false)
(declare-datatypes ((nat 0)(list 0)(tree 0)) (((succ (pred nat)) (zero))((cons (car tree) (cdr list)) (null))((node (data nat) (children list)) (leaf))))
(declare-fun x () nat)
(declare-fun y () list)
(declare-fun z () tree)
(assert (= x (succ zero)))
(assert (= z (ite ((_ is cons) y) (car y) (node x null))))
(set-info :status unsat)
(check-sat-assuming ( (not (=> (not ((_ is cons) y)) (= (pred (data z)) zero))) ))
