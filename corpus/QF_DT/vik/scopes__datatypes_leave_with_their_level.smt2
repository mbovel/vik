; Hand-written for VIK (this repository's license): a datatype declared inside a level goes with the
; level's `pop`, and its name and its constructors' are free again (issue 40): re-declared with other
; constructors, with more, and the popped constructor names reused as integer constants. VIK kept the
; first datatype's exhaustiveness and distinctness and answered unsat on each of the sat checks.
(set-logic ALL)
(push 1)
(declare-datatype D ((a) (b)))
(declare-const d D)
(assert (= d a))
(set-info :status sat)
(check-sat)
(pop 1)
(declare-datatype D ((c)))
(declare-const e D)
(assert (= e c))
(set-info :status sat)
(check-sat)
(reset-assertions)
(push 1)
(declare-datatype E ((A) (B)))
(declare-const x E)
(assert (not ((_ is A) x)))
(set-info :status sat)
(check-sat)
(pop 1)
(declare-datatype E ((A) (B) (C)))
(declare-const y E)
(assert (and (not ((_ is A) y)) (not ((_ is B) y))))
(set-info :status sat)
(check-sat)
(assert (not ((_ is C) y)))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(push 1)
(declare-datatype F ((m) (n)))
(declare-const z F)
(assert (= z m))
(set-info :status sat)
(check-sat)
(pop 1)
(declare-const m Int)
(declare-const n Int)
(assert (= m n))
(assert (= m 5))
(set-info :status sat)
(check-sat)
