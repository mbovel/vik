; origin: Scala 3 qualified types (scala3-rt branch qualifiers-vik), one implication checked by the qualifier solver while compiling the test `avoidance.scala`, Int/Long as 32/64-bit vectors
; original path: tests/*-custom-args/qualified-types/avoidance.scala, dumped with -Yqualified-types-smt-dump (bit-vector default)
; license: Apache-2.0 (the scala3 repository); :status unsat = proved by the e-graph, unknown = not proved
; logic: QF_UFBV, narrowed from QF_UFBVDT, which claims more than the script uses (prune logic)
(set-info :source |qualified types implication; e-graph: proved|)
(set-info :status unsat)
(set-logic QF_UFBV)
(declare-fun x () (_ BitVec 32))
(declare-fun y () (_ BitVec 32))
(declare-fun x0 () (_ BitVec 32))
(declare-fun Predef$.runtimeChecked_scala.Int ((_ BitVec 32)) (_ BitVec 32))
(assert (bvslt x y))
(assert (= y x0))
(assert (bvslt x x0))
(assert (= y x0))
(assert (bvslt x x0))
(assert (bvslt x y))
(assert (= x0 (Predef$.runtimeChecked_scala.Int y)))
(assert (not (= y x0)))
(check-sat)
