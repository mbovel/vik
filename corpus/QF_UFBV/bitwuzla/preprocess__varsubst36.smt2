(set-logic QF_UFBV)
(declare-fun a () (_ BitVec 1))
(declare-fun b () (_ BitVec 1))
(declare-fun f ((_ BitVec 1)) (_ BitVec 1))
(assert (= b (f a)))
(push 1)
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (= b (_ bv0 1)))
(set-info :status sat)
(check-sat)
(pop 1)
(assert (= a (_ bv0 1)))
(set-info :status sat)
(check-sat)
