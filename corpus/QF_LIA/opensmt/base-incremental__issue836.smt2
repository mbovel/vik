(set-logic QF_LIA)
(declare-fun b () Bool)
(declare-fun x () Int)
(declare-fun y () Int)

(assert (and (= x y) b (or (not b) (= x 1))))
(push 1)
(assert (> x 0))
(set-info :status sat)
(check-sat)
(push 1)
(assert (= y 1))
(set-info :status sat)
(check-sat)
(push 1)
(assert (> y 0))
(set-info :status sat)
(check-sat)
