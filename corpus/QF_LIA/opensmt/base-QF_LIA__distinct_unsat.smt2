(set-logic QF_LIA)
(set-info :status unsat)
(declare-fun a () Int)
(declare-fun b () Int)
(declare-fun c () Int)
(assert (not (distinct a b c)))
(assert (not (= a b)))
(assert (not (= a c)))
(assert (not (= b c)))
(set-info :status unsat)
(check-sat)
(exit)
