(set-logic QF_LIA)
(declare-fun |1| () Bool)
(declare-fun |123| () Bool)
(declare-fun x () Int)
(declare-fun y () Int)
(assert (as |123| Bool))
(assert (not (as |1| Bool)))
(assert (= x 123))
(assert (= y 1))
(set-info :status sat)
(check-sat)
