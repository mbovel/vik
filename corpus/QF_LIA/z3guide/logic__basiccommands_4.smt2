; From z3guide: 01 - logic/02 - basiccommands.md (block 4) (MIT, LICENSES/z3guide.txt)
; statuses: by hand from the guide (z3 answers them, then errors on the `p` the `reset` forgot, as the page shows)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(push)
(assert (= (+ x y) 10))
(assert (= (+ x (* 2 y)) 20))
(set-info :status sat)
(check-sat)
(pop) ; remove the two assertions
(push) 
(assert (= (+ (* 3 x) y) 10))
(assert (= (+ (* 2 x) (* 2 y)) 21))
(set-info :status unsat)
(check-sat)
(declare-const p Bool)
(pop)
(assert p) ; error, since declaration of p was removed from the stack
