; EXPECT: sat
; logic: QF_LIA, the smallest the script fits, for QF_UFLIA (prune logic)
(set-logic QF_LIA)
(declare-fun a () Int)
(declare-fun b () Int)
(declare-fun c () Int)
(declare-fun d () Int)
(declare-fun e () Int)
(declare-fun f () Int)
(declare-fun g () Int)
(declare-fun h () Int)
(declare-fun i () Int)
(declare-fun j () Int)
(assert (not (distinct a b c d e g h i j)))
(set-info :status sat)
(check-sat)
