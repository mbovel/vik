; EXPECT: sat
; EXPECT: ((x 1))
; EXPECT: ((y 0))
; EXPECT: ((z 2))
(declare-fun x () Int)
(declare-fun y () Int)
(declare-fun z () Int)
(assert (< x z))
(assert (< y z))
(assert (< z 5))
(assert (distinct x y))
(maximize x)
(maximize y)
(set-info :status sat)
(check-sat)
(get-objectives)
(get-value (x))
(get-value (y))
(get-value (z))
