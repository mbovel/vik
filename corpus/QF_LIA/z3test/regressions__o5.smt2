; logic: QF_LIA, the smallest the script fits, which set none (prune logic)
(set-logic QF_LIA)
(declare-const x Int)
(declare-const y Int)
(assert (<= x y))
(assert (<= y 5))
(maximize x)
(set-info :status sat)
(check-sat)
(get-objectives)
