; From cvc5-examples: linear_arith.smt2 (modified BSD, LICENSES/cvc5.txt)
; statuses: the `unknown` ones answered by Z3 version 4.14.0 (statusstamp, 2026-09-03)
(set-logic QF_LIRA)
(declare-const x Int)
(declare-const y Real)
(assert
    (and
        (>= x (* 3 y))
        (<= x y)
        (< (- 2) x)
    )
)
(push 1)
(echo "Checking entailement by asserting the negation")
(echo "Unsat == ENTAILED")
(assert (not (<= (- y x) (/ 2 3))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(echo "Checking that the assertions are consistent")
(assert (= (- y x) (/ 2 3)))
(set-info :status sat)
(check-sat)
(pop 1)
