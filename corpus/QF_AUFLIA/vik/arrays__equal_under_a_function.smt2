; Hand-written for VIK (this repository's license): two arrays equal by extensionality, `a` a store on
; `b` of what `b` holds there, met only as the argument of a function — into an uninterpreted sort, into
; Bool, into an array — must be equated for the function's applications to be (issue 39). Before the
; fix only a function into Int or Real equated them, and each check answered sat.
(set-logic QF_AUFLIA)
(declare-sort U 0)
(declare-const a (Array Int Int))
(declare-const b (Array Int Int))
(declare-fun f ((Array Int Int)) U)
(declare-fun p ((Array Int Int)) Bool)
(declare-fun g ((Array Int Int)) (Array Int Int))
(assert (= a (store b 0 (select b 0))))
(push 1)
(assert (not (= (f a) (f b))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (not (= (p a) (p b))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (not (= (select (g a) 1) (select (g b) 1))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (= (f a) (f b)))
(assert (p a))
(assert (not (p b)))
(set-info :status unsat)
(check-sat)
(pop 1)
(assert (= (f a) (f b)))
(set-info :status sat)
(check-sat)
