; Hand-written for VIK (this repository's license): two arrays over a one-bit index that agree at both
; indices are equal. The witness index of the arrays asserted different was an integer without the range
; of its sort, which the lowering had erased to `Int`, so the arrays could still differ at it (issue 20,
; 2026-09-05).
(set-logic QF_ABV)
(set-option :global-declarations true)
(declare-const a (Array (_ BitVec 1) (_ BitVec 1)))
(declare-const b (Array (_ BitVec 1) (_ BitVec 1)))
(declare-const c (Array (_ BitVec 2) (_ BitVec 4)))
(declare-const d (Array (_ BitVec 2) (_ BitVec 4)))
(assert (= (select a #b0) (select b #b0)))
(assert (= (select a #b1) (select b #b1)))
(assert (= (select c #b00) (select d #b00)))
(assert (= (select c #b01) (select d #b01)))
(assert (= (select c #b10) (select d #b10)))
(set-info :status sat)
(check-sat)
(assert (not (= c d)))
(set-info :status sat)
(check-sat)
(assert (= (select c #b11) (select d #b11)))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= (select a #b0) (select b #b0)))
(assert (= (select a #b1) (select b #b1)))
(assert (not (= a b)))
(set-info :status unsat)
(check-sat)
