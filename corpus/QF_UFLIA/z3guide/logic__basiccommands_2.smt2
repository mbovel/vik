; logic: QF_UFLIA, the smallest the script fits, which set none (prune logic)
(set-logic QF_UFLIA)
(declare-const a Int)
(declare-fun f (Int Bool) Int)
(assert (< a 10))
(assert (< (f a true) 100))
(set-info :status sat)
(check-sat)
