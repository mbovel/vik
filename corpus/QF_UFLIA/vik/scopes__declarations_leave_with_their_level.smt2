; Hand-written for VIK (this repository's license): a declaration or a definition made inside a level
; goes with the level's `pop`, and the name is free again for another sort (issue 40): a constant Int
; then Real, Int then Bool, a function re-sorted, a definition then a declaration. VIK kept the first
; declaration's sort, variable and class alive in the encoder, and answered against each of these.
; The groups sit under a level of their own, so the names are free again after it; with
; `:global-declarations` true the declarations stay, as the last group checks.
(set-logic ALL)
(declare-const a Int)
(declare-const b Int)
(push 1)
(push 1)
(declare-const x Int)
(assert (> x 0))
(set-info :status sat)
(check-sat)
(pop 1)
(declare-const x Real)
(assert (< 0.0 x 1.0))
(set-info :status sat)
(check-sat)
(push 1)
(declare-const y Int)
(assert (> y 0))
(set-info :status sat)
(check-sat)
(pop 1)
(declare-const y Bool)
(declare-const z Bool)
(declare-fun f (Bool) Int)
(assert (and (not y) (not z) (distinct (f y) (f z))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(push 1)
(declare-fun g (Int) Int)
(assert (> (g a) 0))
(set-info :status sat)
(check-sat)
(pop 1)
(declare-fun g (Int) Bool)
(declare-fun h (Bool) Int)
(assert (and (not (g a)) (not (g b)) (distinct (h (g a)) (h (g b)))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(push 1)
(define-fun p () Bool true)
(define-fun q () Int 5)
(assert p)
(set-info :status sat)
(check-sat)
(pop 1)
(declare-const p Bool)
(declare-const q Int)
(assert (not p))
(assert (= q 6))
(set-info :status sat)
(check-sat)
(pop 1)
(reset)
(set-logic ALL)
(set-option :global-declarations true)
(push 1)
(declare-const k Int)
(assert (> k 0))
(set-info :status sat)
(check-sat)
(pop 1)
(assert (< k 0))
(set-info :status sat)
(check-sat)
