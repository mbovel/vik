; Hand-written for VIK (this repository's license): two bounds on one term that contradict each other at
; the top level, asserted as units — the second is refused by the simplex before any search — must keep
; every later check unsat: a re-check, a check under a push, a check under an assumption (issue 37).
; Before the fix the second check answered sat with y = 0, z = -1, and the audit's fuzzer found the
; last group.
(set-logic QF_UFLIA)
(set-option :global-declarations true)
(set-option :produce-models true)
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(declare-fun f (Int) Int)
(assert (< z y))
(assert (not (<= z y)))
(set-info :status unsat)
(check-sat)
(set-info :status unsat)
(check-sat)
(push 1)
(assert (>= x 0))
(set-info :status unsat)
(check-sat)
(pop 1)
(set-info :status unsat)
(check-sat-assuming ((<= x 100)))
(reset-assertions)
(assert (= y (+ y z)))
(push 1)
(pop 1)
(assert (not (= (+ z y) y)))
(set-info :status unsat)
(check-sat)
(set-info :status unsat)
(check-sat-assuming ((not (<= (- z z) 3)) (not (<= (f x) 1))))
(set-info :status unsat)
(check-sat)
