; From smt-switch: qf_ufbv/test-define-sort.smt2 (BSD-3-Clause, LICENSES/smt-switch.txt)
; logic: QF_BV, the smallest the script fits, for QF_UFBV (prune logic)
(set-logic QF_BV)
(define-sort Word () (_ BitVec 32))
(declare-const x Word)
(declare-const y Word)
(assert (= ((_ extract 31 31) x) #b1))
(assert (= ((_ extract 31 31) y) #b0))
(assert (bvult x y))
(set-info :status unsat)
(check-sat)
