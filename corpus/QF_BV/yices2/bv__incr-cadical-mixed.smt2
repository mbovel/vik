(set-logic QF_BV)
(declare-fun a () (_ BitVec 8))
(assert (bvult a #x80))
(set-info :status sat)
(check-sat)
(push 1)
(assert (= a #x00))
(set-info :status sat)
(check-sat)
(pop 1)
(assert (bvugt a #x00))
(set-info :status sat)
(check-sat)
(push 1)
(assert (= a #xff))
(set-info :status unsat)
(check-sat)
(pop 1)
(set-info :status sat)
(check-sat)
