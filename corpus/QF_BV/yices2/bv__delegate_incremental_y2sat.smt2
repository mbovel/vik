(set-logic QF_BV)
(declare-fun x () (_ BitVec 8))
(assert (= x (_ bv0 8)))
(set-info :status sat)
(check-sat)
(push 1)
(assert (= x (_ bv1 8)))
(set-info :status unsat)
(check-sat)
(pop 1)
(set-info :status sat)
(check-sat)
(assert (= x (_ bv1 8)))
(set-info :status unsat)
(check-sat)
