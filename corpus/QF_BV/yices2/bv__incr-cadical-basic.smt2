(set-logic QF_BV)
(declare-fun x () (_ BitVec 8))
(push 1)
(assert (= x #xff))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (= x #x00))
(set-info :status sat)
(check-sat)
(pop 1)
(assert (= x #x7f))
(set-info :status sat)
(check-sat)
