(set-logic QF_BV)
(declare-fun x () (_ BitVec 8))
(push 1)
(assert (= x #x00))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (and (bvugt x #x00) (bvult x #x10)))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (= x #x00))
(assert (bvugt x #x00))
(set-info :status unsat)
(check-sat)
(pop 1)
