(set-logic QF_BV)
(declare-fun x () (_ BitVec 8))
(push 1)
(assert (= x #x01))
(set-info :status sat)
(check-sat)
(pop 1)
(push 1)
(assert (= x #x02))
(assert (= x #x01))
(set-info :status unsat)
(check-sat)
(pop 1)
