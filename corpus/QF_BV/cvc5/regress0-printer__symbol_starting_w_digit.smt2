; From cvc5: regress0/printer/symbol_starting_w_digit.smt2 (modified BSD, LICENSES/cvc5.txt)
; EXPECT: sat
; EXPECT: ((|0_0| #b0001))
; EXPECT: ((x #b0011))
(set-option :produce-models true)
(set-logic QF_BV)
(declare-const |0_0| (_ BitVec 4))
(declare-const x (_ BitVec 4))
(assert (= |0_0| #b0001))
(assert (= x #b0011))
(set-info :status sat)
(check-sat)
(get-value (|0_0|))
(get-value (x))
