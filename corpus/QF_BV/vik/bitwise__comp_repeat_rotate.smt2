; Hand-written for VIK (this repository's license): `bvcomp` as a case on the equality, `repeat` as a sum of
; shifted copies, the rotations as one division — each against its definition (2026-09-03).
(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(push 1)
(assert (= (bvcomp x y) #b1))
(assert (distinct x y))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (= (bvcomp x y) #b0))
(assert (= x y))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct ((_ repeat 3) x) (concat x x x)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct ((_ rotate_left 3) x) (concat ((_ extract 4 0) x) ((_ extract 7 5) x))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct ((_ rotate_right 3) x) (concat ((_ extract 2 0) x) ((_ extract 7 3) x))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct ((_ rotate_left 11) x) ((_ rotate_left 3) x)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (= ((_ rotate_left 1) x) (bvmul x #x02)))
(assert (bvuge x #x80))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (= (bvcomp x y) #b1))
(assert (= ((_ rotate_right 2) x) #x40))
(set-info :status sat)
(check-sat)
(pop 1)
