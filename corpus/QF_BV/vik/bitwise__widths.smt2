; Hand-written for VIK (this repository's license): bitwise operations at width 1, at an odd width, and at
; 64 bits, where the bits' weights reach 2^63 (2026-09-03).
(set-logic QF_BV)
(declare-const a (_ BitVec 1))
(declare-const b (_ BitVec 1))
(declare-const p (_ BitVec 5))
(declare-const q (_ BitVec 5))
(declare-const u (_ BitVec 64))
(declare-const v (_ BitVec 64))
(assert (= (bvxor a b) #b1))
(assert (= (bvand a b) #b0))
(assert (= (bvor p q) #b10101))
(assert (= (bvand p q) #b00100))
(assert (bvult p q))
(assert (= (bvand u v) #x8000000000000001))
(assert (= (bvor u v) #xffffffffffffffff))
(assert (= (bvxor u #x00000000ffffffff) v))
(set-info :status unsat)
(check-sat)
(reset)
(set-logic QF_BV)
(declare-const u (_ BitVec 64))
(declare-const v (_ BitVec 64))
(assert (= (bvand u v) #x8000000000000001))
(assert (= (bvor u v) #xffffffffffffffff))
(assert (= (bvxor u #x7ffffffffffffffe) v))
(assert (bvugt u v))
(set-info :status sat)
(check-sat)
