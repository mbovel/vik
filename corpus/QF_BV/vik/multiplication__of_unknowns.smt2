; Hand-written for VIK (this repository's license): `bvmul` of two unknowns, shift-and-add over the bits of
; one operand — a factorization of an odd number, a product of one, a square (2026-09-03).
; The declarations are global, so that they stay over `reset-assertions`, which forgets the others (issue 246).
(set-option :global-declarations true)
(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(assert (= (bvmul x y) #x8f))
(assert (bvugt x #x01))
(assert (bvugt y #x01))
(assert (bvult x y))
(set-info :status sat)
(check-sat)
(reset-assertions)
(assert (= (bvmul x y) #x01))
(assert (= ((_ extract 0 0) x) #b0))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= (bvmul x x) #x02))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= (bvmul x x) #x09))
(assert (bvugt x #x10))
(set-info :status sat)
(check-sat)
(reset-assertions)
(assert (= (bvmul x y) #x8f))
(assert (= (bvmul y x) #x01))
(set-info :status unsat)
(check-sat)
