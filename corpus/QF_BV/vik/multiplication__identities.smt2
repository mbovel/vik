; Hand-written for VIK (this repository's license): identities of a product of two unknowns, each negated —
; commutativity (the operands are lowered in one order, so it is syntactic), one step of distributivity,
; the sign, distributivity over a constant, and a product with a bitwise operand (2026-09-03).
; The declarations are global, so that they stay over `reset-assertions`, which forgets the others (issue 246).
(set-option :global-declarations true)
(set-logic QF_BV)
(declare-const x (_ BitVec 6))
(declare-const y (_ BitVec 6))
(declare-const z (_ BitVec 6))
(assert (distinct (bvmul x y) (bvmul y x)))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (distinct (bvmul x (bvadd y (_ bv1 6))) (bvadd (bvmul x y) x)))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (distinct (bvmul x y) (bvneg (bvmul x (bvneg y)))))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (distinct (bvmul (bvadd x y) (_ bv3 6)) (bvadd (bvmul x (_ bv3 6)) (bvmul y (_ bv3 6)))))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (distinct (bvmul x (_ bv2 6)) (bvadd x x)))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (distinct (bvmul (bvand x y) z) (bvmul z (bvand y x))))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= (bvmul x y) (bvor x y)))
(assert (bvugt x #b000011))
(assert (bvugt y #b000011))
(set-info :status sat)
(check-sat)
(reset-assertions)
(assert (= (bvmul x y) (_ bv0 6)))
(assert (bvugt x (_ bv0 6)))
(assert (bvugt y (_ bv0 6)))
(set-info :status sat)
(check-sat)
