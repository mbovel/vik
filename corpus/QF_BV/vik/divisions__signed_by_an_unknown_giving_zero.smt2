; Hand-written for VIK (this repository's license): signed divisions by an unknown divisor whose quotient
; or remainder is zero. The sign flip was written `2^n - q` without reducing, so a zero came out as `2^n`,
; outside the width, and the definition was unsatisfiable: `(bvsdiv #b0001 #b1110)` answered unsat
; (issue 9, 2026-09-04).
(set-logic QF_BV)
(set-option :global-declarations true)
(declare-const x (_ BitVec 4))
(declare-const y (_ BitVec 4))
(declare-const q (_ BitVec 4))
(declare-const r (_ BitVec 4))
(declare-const s (_ BitVec 4))
(assert (= x #b0001))
(assert (= y #b1110))
(assert (= q (bvsdiv x y)))
(set-info :status sat)
(check-sat)
(assert (= q #b0000))
(set-info :status sat)
(check-sat)
(push 1)
(assert (not (= q #b0000)))
(set-info :status unsat)
(check-sat)
(pop 1)
(reset-assertions)
(assert (= x #b1100))
(assert (= y #b0010))
(assert (= r (bvsrem x y)))
(assert (= s (bvsmod x y)))
(set-info :status sat)
(check-sat)
(assert (= r #b0000))
(assert (= s #b0000))
(set-info :status sat)
(check-sat)
(assert (not (= (bvsdiv x y) #b1110)))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(declare-const a (_ BitVec 1))
(declare-const b (_ BitVec 1))
(assert (= a #b0))
(assert (= b #b1))
(assert (= (bvsdiv a b) #b0))
(assert (= (bvsrem a b) #b0))
(assert (= (bvsmod a b) #b0))
(set-info :status sat)
(check-sat)
