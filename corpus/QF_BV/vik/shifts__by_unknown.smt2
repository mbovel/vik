; Hand-written for VIK (this repository's license): shifts by an unknown amount, a barrel shifter over the
; amount's bits — the value shifted, the amount recovered, and an amount past the width (2026-09-04).
; The declarations are global, so that they stay over `reset-assertions`, which forgets the others (issue 246).
(set-option :global-declarations true)
(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const s (_ BitVec 8))
(assert (= (bvshl #x01 s) #x20))
(set-info :status sat)
(check-sat)
(assert (distinct s #x05))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= (bvshl x s) #x00))
(assert (bvugt x #x00))
(assert (bvult s #x08))
(set-info :status sat)
(check-sat)
(reset-assertions)
(assert (bvuge s #x08))
(assert (distinct (bvshl x s) #x00))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvuge s #x08))
(assert (distinct (bvlshr x s) #x00))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= (bvlshr #xf0 s) #x0f))
(set-info :status sat)
(check-sat)
(assert (distinct s #x04))
(set-info :status unsat)
(check-sat)
