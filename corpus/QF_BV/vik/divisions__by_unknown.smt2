; Hand-written for VIK (this repository's license): `bvudiv` and `bvurem` by an unknown divisor — the
; quotient and the remainder of one exact product, the divisor zero answered all ones and the dividend
; (2026-09-04).
; The declarations are global, so that they stay over `reset-assertions`, which forgets the others (issue 246).
(set-option :global-declarations true)
(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(assert (= (bvudiv x y) #x0a))
(assert (= (bvurem x y) #x02))
(assert (= y #x07))
(set-info :status sat)
(check-sat)
(assert (distinct x #x48))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= y #x00))
(assert (distinct (bvudiv x y) #xff))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= y #x00))
(assert (distinct (bvurem x y) x))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvugt y #x00))
(assert (bvuge (bvurem x y) y))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= (bvudiv x y) #x00))
(assert (bvugt x #x00))
(assert (bvugt y x))
(set-info :status sat)
(check-sat)
