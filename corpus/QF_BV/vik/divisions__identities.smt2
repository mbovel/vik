; Hand-written for VIK (this repository's license): identities of the divisions by an unknown, each negated —
; the Euclidean law, division by one and by itself, and the signed divisions' signs (2026-09-04).
(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const y (_ BitVec 8))
(assert (bvugt y #x00))
(assert (distinct (bvadd (bvmul (bvudiv x y) y) (bvurem x y)) x))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (distinct (bvudiv x #x01) x))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvugt x #x00))
(assert (distinct (bvudiv x x) #x01))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvuge x #x80))
(assert (bvult y #x80))
(assert (bvugt y #x00))
(assert (bvult (bvsdiv x y) #x80))
(assert (distinct (bvsdiv x y) #x00))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvugt y #x00))
(assert (bvult y #x80))
(assert (= (bvsrem x y) #x00))
(assert (distinct (bvsmod x y) #x00))
(set-info :status unsat)
(check-sat)
