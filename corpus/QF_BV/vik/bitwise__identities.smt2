; Hand-written for VIK (this repository's license): identities of the bitwise operations, each negated —
; commutativity, De Morgan, `x xor x = 0`, absorption, and the three negated operations (2026-09-03).
(set-logic QF_BV)
(declare-const x (_ BitVec 16))
(declare-const y (_ BitVec 16))
(declare-const z (_ BitVec 16))
(push 1)
(assert (distinct (bvand x y) (bvand y x)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvnot (bvand x y)) (bvor (bvnot x) (bvnot y))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvxor x x) #x0000))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvor x (bvand x y)) x))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvnand x y) (bvnot (bvand x y))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvnor x y) (bvnot (bvor x y))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvxnor x y) (bvnot (bvxor x y))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvand x y z) (bvand x (bvand y z))))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvxor x y z) (bvxor (bvxor x y) z)))
(set-info :status unsat)
(check-sat)
(pop 1)
(push 1)
(assert (distinct (bvxor x y) (bvor (bvand x (bvnot y)) (bvand (bvnot x) y))))
(set-info :status unsat)
(check-sat)
(pop 1)
