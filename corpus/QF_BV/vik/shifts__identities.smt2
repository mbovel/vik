; Hand-written for VIK (this repository's license): identities of the shifts by an unknown amount, each
; negated — a left shift is a product by a power of two, a right shift its inverse on the low bits, an
; arithmetic shift keeps the sign, and a shift past the width is zero or the sign (2026-09-04).
; The declarations are global, so that they stay over `reset-assertions`, which forgets the others (issue 246).
(set-option :global-declarations true)
(set-logic QF_BV)
(declare-const x (_ BitVec 8))
(declare-const s (_ BitVec 8))
(assert (distinct (bvshl x #x03) (bvmul x #x08)))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvult s #x08))
(assert (bvult x (bvlshr #xff s)))
(assert (distinct (bvlshr (bvshl x s) s) x))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvuge x #x80))
(assert (bvult s #x08))
(assert (bvult (bvashr x s) #x80))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvuge s #x08))
(assert (bvuge x #x80))
(assert (distinct (bvashr x s) #xff))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (bvuge s #x08))
(assert (bvult x #x80))
(assert (distinct (bvashr x s) #x00))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(assert (= (bvashr x s) #xfe))
(assert (bvult s #x08))
(set-info :status sat)
(check-sat)
