; logic: QF_BV, the smallest the script fits, which set none (prune logic)
(set-logic QF_BV)
(declare-const c (_ BitVec 1))
(assert (or true (distinct (_ bv0 32) ((_ zero_extend 31) c))))
(push 1)
(set-info :status sat)
(check-sat)
(pop 1)
(assert (distinct (_ bv0 32) ((_ zero_extend 31) c)))
(set-info :status sat)
(check-sat)
