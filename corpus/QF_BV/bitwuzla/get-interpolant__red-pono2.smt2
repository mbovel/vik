; logic: QF_BV, the smallest the script fits, which set none (prune logic)
(set-logic QF_BV)
(declare-const x Bool)
(set-option :produce-interpolants true)
(declare-const n (_ BitVec 1))
(declare-const p (_ BitVec 1))
(push 1)
(push 1)
(assert (= (_ bv0 1) (bvand (bvnot p) (bvnot n))))
(set-info :status sat)
(check-sat)
(pop 1)
(assert (! (and (= p (_ bv1 1)) (and x (and (= (bvnot p) (_ bv1 1)) (= (bvnot n) (_ bv1 1))))) :named a5))
(assert true)
(set-info :status unsat)
(check-sat)
(get-interpolant (a5))
