; ignore output
; logic: QF_BV, the smallest the script fits, which set none (prune logic)
(set-logic QF_BV)
(declare-const x (_ BitVec 3))
(declare-const y (_ BitVec 3))
(set-option :produce-interpolants true)
(push 1)
(assert (= y (ite (bvult x (_ bv1 3)) x (_ bv0 3))))
(push 1)
(set-info :status sat)
(check-sat)
(pop 2)
(assert (! (= y (ite (bvult x (_ bv1 3)) (bvadd (_ bv1 3) x) (_ bv0 3))) :named a1))
(assert (bvult (_ bv1 3) y))
(set-info :status unsat)
(check-sat)
(get-interpolant (a1))
