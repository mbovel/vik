; logic: QF_BV, the smallest the script fits, which set none (prune logic)
(set-logic QF_BV)

(declare-fun S () Bool)
(declare-fun c () (_ BitVec 4))
(declare-fun Sc () (_ BitVec 1))
(assert S)
(push 1)
(assert (not true))
(set-info :status unsat)
(check-sat)
(pop 1)
(declare-fun $ () (_ BitVec 1))
(assert (and (= c (concat (bvand $ Sc) (_ bv0 1) (_ bv0 2))) (= (_ bv0 4) (concat Sc (_ bv0 1) (_ bv0 2)))))
(push 1)
(assert (not true))
(set-info :status unsat)
(check-sat)
(pop 1)
(set-info :status sat)
(check-sat)
