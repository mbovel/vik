; logic: QF_BV, the smallest the script fits, which set none (prune logic)
(set-logic QF_BV)
(declare-const x Bool)
(declare-fun s () (_ BitVec 1))
(push 1)
(assert false)
(set-info :status unsat)
(check-sat)
(pop 1)
(assert (or x (= s (_ bv1 1))))
(assert (= s (ite x (_ bv1 1) (_ bv0 1))))
(push 1)
(set-info :status sat)
(check-sat)
