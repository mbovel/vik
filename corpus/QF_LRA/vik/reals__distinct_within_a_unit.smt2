; Hand-written for VIK (this repository's license): `distinct` over reals separates by any amount, not by
; one. It was lowered as the integers' apartness (`a + 1 <= b` or `b + 1 <= a`), which forbids the whole
; open band and answered unsat on a satisfiable script (issue 7, 2026-09-04).
(set-logic QF_LRA)
(declare-const x Real)
(declare-const y Real)
(assert (distinct x 0.0))
(assert (< 0.0 x))
(assert (< x 1.0))
(set-info :status sat)
(check-sat)
(assert (distinct x y))
(assert (< 0.0 y))
(assert (< y 1.0))
(set-info :status sat)
(check-sat)
(assert (= x y))
(set-info :status unsat)
(check-sat)
(reset-assertions)
(declare-const a Real)
(declare-const b Real)
(declare-const c Real)
(assert (distinct a b c))
(assert (<= 0.0 a))
(assert (<= a 1.0))
(assert (<= 0.0 b))
(assert (<= b 1.0))
(assert (<= 0.0 c))
(assert (<= c 1.0))
(set-info :status sat)
(check-sat)
