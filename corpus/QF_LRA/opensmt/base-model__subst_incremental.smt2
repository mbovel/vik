(set-option :produce-models true)
(set-logic QF_LRA)
(declare-fun x () Real)
(declare-fun y () Real)
(declare-fun z () Real)
(declare-fun a () Bool)
(declare-fun b () Bool)
(assert (=> a b))
;(assert (=> a (not b)))
(set-info :status sat)
(check-sat)
(push 1)
(assert (not a))
(set-info :status sat)
(check-sat)
(get-value (a))
(exit)
