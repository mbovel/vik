(set-logic QF_LRA)
(declare-fun a () Bool)
(declare-fun b () Bool)
(assert (=> a b))
(set-info :status sat)
(check-sat)
(push 1)
(assert (=> a (not b)))
(assert (=> (not a) (not b)))
(assert (=> (not a) b))
(set-info :status unsat)
(check-sat)
(pop 1)
(set-info :status sat)
(check-sat)
