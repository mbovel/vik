; logic: QF_LRA, the smallest the script fits, for QF_NRA (prune logic)
(set-logic QF_LRA)
(declare-const r5 Real)
(declare-const r6 Real)
(set-info :status sat)
(check-sat)
(set-info :status sat)
(check-sat)
(push 1)
(assert false)
(push 1)
(set-info :status unsat)
(check-sat)
(pop 1)
(pop 1)
(assert (< r5 0.0 r6 r5))
(push 1)
(push 1)
(set-info :status unsat)
(check-sat)
