; statuses: the `unknown` ones answered by Z3 version 4.14.0 (statusstamp, 2026-09-03)
; logic: QF_LRA, the smallest the script fits, which set none (prune logic)
(set-logic QF_LRA)
(declare-const x Real)
(declare-const y Real)
(assert (< x 4))
(assert (< y 5))
(maximize (+ x y))
(set-info :status sat)
(check-sat)
(get-objectives)
